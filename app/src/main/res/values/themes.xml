<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Login_APP" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.Login_APP.splash" parent="Theme.SplashScreen">
        <!-- Color de fondo del splash -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- Tu icono (usa el mipmap que ya creaste) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Duración de la animación de salida (ms) -->
        <item name="windowSplashScreenAnimationDuration">500</item>

        <!-- Tema que se aplica DESPUÉS del splash -->
        <item name="postSplashScreenTheme">@style/Theme.Login_APP</item>
    </style>
</resources>